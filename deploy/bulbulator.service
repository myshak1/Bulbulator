[Unit]
Description=Bulbulator - fermentation airlock bubble counter
After=network-online.target
Wants=network-online.target

[Service]
User=www-data
Group=www-data
# Edit these lines to match your setup (see README).
Environment=BULBULATOR_STREAM=http://127.0.0.1:8090/stream
Environment=BULBULATOR_JARS=2
Environment=BULBULATOR_DATA=/var/lib/bulbulator
Environment=BULBULATOR_STATE=/run/bulbulator
Environment=BULBULATOR_WEB=/opt/bulbulator/web
# Built-in web page (comment out when nginx serves the page instead):
Environment=BULBULATOR_HTTP=0.0.0.0:8088
#Environment=BULBULATOR_AUTH=user:password
# A local USB camera needs the video group:
SupplementaryGroups=video
ExecStart=/usr/bin/python3 /opt/bulbulator/bulbulator.py
StateDirectory=bulbulator
RuntimeDirectory=bulbulator
RuntimeDirectoryMode=0755
Restart=always
RestartSec=5
Nice=5

[Install]
WantedBy=multi-user.target
